# Образец. Настоящий .env — только на сервере, права 600.
# Ключа Twelve Data нет, токен служебной ручки сознательно не заводится.

# Модуль рыночных данных: ключ в пути адреса, адрес и есть секрет.
# Пусто у MARKET_* — Binance напрямую. У терминала — свои в ../terminal/.env.
MARKET_API_URL=https://<хост>/<ключ>
MARKET_WS_URL=wss://<хост>/<ключ>
MARKET_V2_API_URL=https://<хост>/<ключ>

# Инструменты платформы из CMS (21.11).
# CMS_API_KEY — тот же, что в ../site/.env.
CMS_API_KEY=<выдать-в-CMS>
# Тот же, что PLATFORM_INSTRUMENTS_WEBHOOK_SECRET в ../cms/.env.
CMS_WEBHOOK_SECRET=<тот же, что PLATFORM_INSTRUMENTS_WEBHOOK_SECRET>
