# Образец. Настоящий .env — только на сервере, права 600.
# ДОМЕНА здесь нет (он в ../proxy/.env), общих с витриной ключей тоже
# (они в ../site/.env) — compose.sh читает все три файла.
CMS_DB_PASSWORD=<сгенерировать>
# Ключ подписи сессий Payload. Значения из docker-compose.yml репозитория
# ПУБЛИЧНЫ с августа и на сервер не едут ни одним байтом.
PAYLOAD_SECRET=<сгенерировать>
SEED_ADMIN_EMAIL=<почта с доменом верхнего уровня — иначе сид падает на валидации>
SEED_ADMIN_PASSWORD=<сгенерировать>
SEED_EDITOR_EMAIL=<почта с доменом верхнего уровня>
SEED_EDITOR_PASSWORD=<сгенерировать>
