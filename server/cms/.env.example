# Образец. Настоящий .env — только на сервере, права 600.
# ДОМЕНА здесь нет (он в ../proxy/.env), общих с витриной ключей тоже
# (они в ../site/.env) — compose.sh читает все три файла.
CMS_DB_PASSWORD=<сгенерировать>
# Ключ подписи сессий Payload. Значения из docker-compose.yml репозитория
# ПУБЛИЧНЫ с августа и на сервер не едут ни одним байтом.
PAYLOAD_SECRET=<сгенерировать>
SEED_ADMIN_EMAIL=<почта с доменом верхнего уровня — иначе сид падает на валидации>
SEED_ADMIN_PASSWORD=<сгенерировать>
SEED_EDITOR_EMAIL=<почта с доменом верхнего уровня>
SEED_EDITOR_PASSWORD=<сгенерировать>

# Инструменты платформы: вебхук подписчикам при сохранении списка в CMS.
# Адреса через запятую (внутренние имена docker). Тот же секрет читают шлюз
# терминала (terminal/compose.sh) и MDS (CMS_WEBHOOK_SECRET в ../mds/.env).
PLATFORM_INSTRUMENTS_WEBHOOK_URLS=http://broker-mds:3003/v1/hooks/platform-instruments,http://broker-terminal-gateway:8080/internal/hooks/platform-instruments
PLATFORM_INSTRUMENTS_WEBHOOK_SECRET=<сгенерировать>

# TERMINAL_INTERNAL_URL/TERMINAL_INTERNAL_TOKEN здесь НЕ задаются: адрес
# шлюза — в compose.yml, токен — INTERNAL_MONEY_TOKEN из ../site/.env.
