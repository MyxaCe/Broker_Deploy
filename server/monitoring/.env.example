# Образец. Настоящий .env — только на сервере, права 600.
GRAFANA_PASSWORD=<сгенерировать>

# --- КУДА ШЛЮТСЯ КРИТИЧЕСКИЕ ОПОВЕЩЕНИЯ -------------------------------
# zhurnal  — в журнал и файл (так сейчас: адресата ещё нет)
# telegram — в Telegram (нужны TG_BOT_TOKEN и TG_CHAT_ID ниже)
# pochta   — на почту (нужны MAIL_* ниже)
POLUCHATEL_KRIT=zhurnal

# Значения-заполнители. Alertmanager проверяет ВСЕ получатели при
# загрузке, и пустое поле уронило бы его целиком, поэтому здесь не пусто.
TG_BOT_TOKEN=nezadan
TG_CHAT_ID=1   # НЕ ноль: ноль Alertmanager считает отсутствующим и падает
MAIL_TO=nezadan@example.com
MAIL_FROM=nezadan@example.com
MAIL_SMTP=localhost:25
MAIL_USER=nezadan
MAIL_PASS=nezadan
