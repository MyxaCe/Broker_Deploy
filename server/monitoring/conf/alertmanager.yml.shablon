global:
  resolve_timeout: 5m

route:
  receiver: zhurnal
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 1h
  routes:
    - matchers: [ 'severity="critical"' ]
      receiver: ${POLUCHATEL_KRIT}
      group_wait: 10s
      repeat_interval: 30m

receivers:
  - name: zhurnal
    webhook_configs:
      - url: 'http://broker-alert-log:8080/'
        send_resolved: true

  - name: telegram
    webhook_configs:
      - url: 'http://broker-alert-log:8080/'
        send_resolved: true
    telegram_configs:
      - bot_token: '${TG_BOT_TOKEN}'
        chat_id: ${TG_CHAT_ID}
        message_thread_id: ${TG_THREAD_ID}
        api_url: 'https://api.telegram.org'
        send_resolved: true
        message: |
          {{ if eq .Status "firing" }}СБОЙ{{ else }}восстановилось{{ end }}: {{ .CommonLabels.alertname }}
          {{ range .Alerts }}{{ .Annotations.summary }}
          {{ end }}

  - name: pochta
    webhook_configs:
      - url: 'http://broker-alert-log:8080/'
        send_resolved: true
    email_configs:
      - to: '${MAIL_TO}'
        from: '${MAIL_FROM}'
        smarthost: '${MAIL_SMTP}'
        auth_username: '${MAIL_USER}'
        auth_password: '${MAIL_PASS}'
        send_resolved: true
