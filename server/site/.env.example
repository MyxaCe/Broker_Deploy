# Образец. Настоящий .env — только на стенде (/srv/broker/site/.env), права 600.
#
# ДОМЕНА ЗДЕСЬ НЕТ СОЗНАТЕЛЬНО: он живёт в ../proxy/.env, и compose.sh читает
# оба файла. Пароли кредлов шины (BUS_SITE_WEB_PASSWORD, BUS_CABINET_PASSWORD)
# тоже НЕ здесь: они приходят из ../bus/.env (compose.sh подключает его третьим
# --env-file), чтобы у пароля шины не было второй правды.
#
# KYC-секреты (S3/MINIO) целятся в OpenBao: Vault Agent рендерит
# ../vault/rendered/.env.kyc, и compose.sh подключает его ПОСЛЕДНИМ — он
# перекрывает одноимённые ключи отсюда. Этот .env — fallback, когда хранилище
# запечатано/недоступно (см. proposed/vault/README.md). Поэтому ключи S3/MINIO
# должны быть и здесь.

# --- База витрины/кабинета -------------------------------------------------
SITE_DB_PASSWORD=<сгенерировать>

# --- Интеграция с CMS ------------------------------------------------------
CMS_WEBHOOK_SECRET=<сгенерировать>
PREVIEW_SECRET=<сгенерировать>
CMS_API_KEY=<выдать-в-CMS>

# --- Центр управления (ADM-01) --------------------------------------------
# Без него broker-admin стартует fail-closed (Р-394).
ADMIN_SESSION_SECRET=<сгенерировать>

# --- Приватный ключ подписи handoff-JWT (SSO в терминал) -------------------
# RSA 2048+, PKCS#8 PEM, base64 ОДНОЙ строкой (base64 -w0 — иначе в .env
# попадёт только первая строка ключа, импорт падает). Без него /api/sso/jwks
# отдаёт 503 sso_not_configured.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     | openssl pkcs8 -topk8 -nocrypt -outform PEM | base64 -w0
SSO_PRIVATE_KEY_B64=<сгенерировать>

# --- KYC object storage (ADM-12 / Р-454 II-1, MinIO на стенде) ------------
# Целевой дом этих четырёх — OpenBao (secret/kyc/*). Здесь — fallback.
# S3_BUCKET создаётся MinIO при старте (MINIO_DEFAULT_BUCKETS=S3_BUCKET).
# Эндпоинт S3 в compose.yml РАЗНЫЙ по сервисам и в .env НЕ задаётся:
#   admin   → https://files.<DOMAIN>  (через прокси, за фильтром ADMIN_IP);
#   cabinet → http://minio:9000       (внутренний, иначе фильтр убил бы PUT).
S3_BUCKET=broker-kyc
S3_ACCESS_KEY_ID=<ключ-доступа-s3>
S3_SECRET_ACCESS_KEY=<секрет-s3>
# Root-учётка MinIO (создаёт сервис minio). Из неё заводится ключ S3 выше.
MINIO_ROOT_USER=<сгенерировать>
MINIO_ROOT_PASSWORD=<сгенерировать>
