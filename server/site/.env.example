# Образец. Настоящий .env — только на сервере, права 600.
# ДОМЕНА ЗДЕСЬ НЕТ СОЗНАТЕЛЬНО: он живёт в ../proxy/.env, и compose.sh
# читает оба файла.
SITE_DB_PASSWORD=<сгенерировать>
CMS_WEBHOOK_SECRET=<сгенерировать>
PREVIEW_SECRET=<сгенерировать>
# Приватный ключ подписи handoff-JWT для терминала. RSA 2048+, PKCS#8 PEM,
# base64 ОДНОЙ строкой (base64 -w0 — без него в .env попадёт первая строка
# из семидесяти шести символов, ключ «есть», а импорт падает).
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     | openssl pkcs8 -topk8 -nocrypt -outform PEM | base64 -w0
SSO_PRIVATE_KEY_B64=<сгенерировать>
