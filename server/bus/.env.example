# Образец. Настоящий .env — только на сервере, права 600.
BUS_ADMIN_USER=bus-admin
BUS_ADMIN_PASSWORD=<сгенерировать>
# Кредлы приложений. Потребителей у них сегодня нет (витрина, кабинет, релей и
# консюмер не развёрнуты) — заводятся вместе с шиной, чтобы топология и права
# не жили только внутри тома.
BUS_SITE_WEB_PASSWORD=<сгенерировать>
BUS_CABINET_PASSWORD=<сгенерировать>
# Издатель событий терминала (TRM-40): только write на platform.events.
BUS_TERMINAL_PASSWORD=<сгенерировать>
