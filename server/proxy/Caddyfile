# Обратный прокси платформы. Сертификаты получает и продлевает сам.
#
# Админки НЕ закрываются брандмауэром: все имена живут на одном порту 443,
# и по адресу назначения их не различить. Поэтому ограничение по источнику
# стоит здесь — это единственное место, где видно, КУДА пришёл запрос.
#
# ДОМЕН И АДРЕС АДМИНА — В `.env` РЯДОМ, И БОЛЬШЕ НИГДЕ. Домен временный:
# смена обязана стоить одну строку, а не поиск по конфигам.

{
	email admin@{$DOMAIN}
}

(adminonly) {
	@chuzhoy not remote_ip {$ADMIN_IP}
	respond @chuzhoy "Dostup ogranichen" 403
}

# ВИТРИНА И КАБИНЕТ — настоящие приложения с 23.10 (OPS-25). Их образы
# домена не знают: адреса подставляются в собранный вывод при старте
# контейнера (Р-220), поэтому смена домена здесь и в `.env` рядом — это
# по-прежнему одна правка, без пересборки.
{$DOMAIN} {
	# ПУБЛИЧНЫЙ ПУТЬ К КОТИРОВКАМ · OPS-29, решение штаба Р-230.
	#
	# Рыночные данные публичны по природе: витрина показывает их анонимному
	# посетителю, и прятать их не от кого. Закрывать надо УПРАВЛЕНИЕ —
	# смену источника, реестр провайдеров, служебные ручки.
	#
	# ОТДЕЛЬНОГО ИМЕНИ У MDS НЕТ И НЕ МОЖЕТ БЫТЬ: записи `mds.` в DNS не
	# существует (проверено запросом; подстановочной записи тоже нет), а
	# завести её может только владелец домена. Поэтому публичные ручки
	# живут на имени витрины.
	#
	# СПИСОК РАЗРЕШЁННОГО, А НЕ ЗАПРЕЩЁННОГО. Перечислены ТОЧНЫЕ пути, не
	# префикс `/v1/*`: `/v1/admin/providers` и `/v1/admin/audit` начинаются
	# с того же `/v1/`, и префиксное правило открыло бы смену источника
	# цены наружу. Новая служебная ручка, добавленная в MDS завтра, по
	# построению останется закрытой — её просто не будет в этом списке.
	@mds_dannye path /v1/quotes /v1/instruments
	handle @mds_dannye {
		reverse_proxy broker-mds:3003
	}

	# Иконки инструментов. Витрина держит в `/icons/` СВОИ три PNG
	# (манифест и логотип), поэтому отдавать весь каталог в MDS нельзя.
	# Правило повторяет регулярное выражение самого MDS — заглавные буквы
	# и только `.svg`, — и потому `path_regexp`, а не `path`: последний в
	# Caddy регистронезависим и стёр бы различие.
	@mds_ikonki path_regexp ^/icons/[A-Z0-9]{1,20}\.svg$
	handle @mds_ikonki {
		reverse_proxy broker-mds:3003
	}

	# Поток котировок (socket.io). Путь `/socket.io/` — умолчание клиента:
	# драйвер витрины зовёт `io(url)` без параметра `path`, то есть адрес
	# обязан быть ORIGIN, а не origin с префиксом. Отсюда и решение
	# повесить ручки на корень имени витрины, а не на `/mds/*`.
	@mds_potok path /socket.io /socket.io/*
	handle @mds_potok {
		reverse_proxy broker-mds:3003
	}

	# Всё остальное — витрине. `/health` и `/v1/admin/*` MDS сюда не
	# попадают вовсе и отвечают как несуществующие страницы витрины.
	handle {
		reverse_proxy broker-web:3000
	}
}

cabinet.{$DOMAIN} {
	reverse_proxy broker-cabinet:3002
}

# ТЕРМИНАЛ — ЕДИНСТВЕННОЕ ИМЯ С НАСТОЯЩИМ ПРИЛОЖЕНИЕМ (OPS-24, этап 2).
#
# Витрина и кабинет остаются заглушками СОЗНАТЕЛЬНО: их образы собраны с
# адресами для разработки, и ссылки входа повели бы в никуда (WEB-22).
# Терминал от этого свободен — он рендерит конфигурацию из окружения на
# старте, а не вшивает её на сборке.
#
# Имя контейнера, а не адрес: Caddy и nginx терминала живут в одной сети
# `broker-edge`, и разрешение имени делает сам Docker. Порт 80 — внутренний,
# наружу не опубликован ни одним контейнером кроме этого прокси.
terminal.{$DOMAIN} {
	reverse_proxy broker-terminal-web:80
}

# АДМИНКА CMS. Ограничение по источнику ОСТАЁТСЯ: наружу она не смотрит.
# Стоит оно здесь, а не в брандмауэре, потому что все имена живут на одном
# порту 443 и по адресу назначения их не различить.
cms.{$DOMAIN} {
	import adminonly
	reverse_proxy broker-cms:3001
}
