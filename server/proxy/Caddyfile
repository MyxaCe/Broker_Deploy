{
	email admin@{$DOMAIN}
}

(adminonly) {
	@chuzhoy not remote_ip {$ADMIN_IP}
	respond @chuzhoy "Dostup ogranichen" 403
}

{$DOMAIN} {
	@mds_dannye path /v1/quotes /v1/instruments
	handle @mds_dannye {
		reverse_proxy broker-mds:3003
	}

	@mds_ikonki path_regexp ^/icons/[A-Z0-9]{1,20}\.svg$
	handle @mds_ikonki {
		reverse_proxy broker-mds:3003
	}

	@mds_potok path /socket.io /socket.io/*
	handle @mds_potok {
		reverse_proxy broker-mds:3003
	}

	handle {
		reverse_proxy broker-web:3000
	}
}

cabinet.{$DOMAIN} {
	reverse_proxy broker-cabinet:3002
}

terminal.{$DOMAIN} {
	reverse_proxy broker-terminal-web:80
}

cms.{$DOMAIN} {
	import adminonly
	reverse_proxy broker-cms:3001
}

admin.{$DOMAIN} {
	@blocked not remote_ip <IP-оператора-1> <IP-оператора-2> <IP-оператора-3> <IP-оператора-4>
	respond @blocked "Dostup ogranichen" 403
	reverse_proxy broker-admin:3005
}

files.{$DOMAIN} {
	import adminonly
	reverse_proxy broker-minio:9000
}
