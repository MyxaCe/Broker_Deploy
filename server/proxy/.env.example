# Образец. Настоящий .env — только на стенде (/srv/broker/proxy/.env), права 600.
#
# Здесь объявлен ДОМЕН платформы — ОДИН раз и больше нигде. И витрина/кабинет
# (site/compose.sh читает этот файл вторым --env-file), и прокси берут домен
# отсюда. Смена домена = одна правка здесь.
#
# В репозиторий кладём только плейсхолдеры. Значения DOMAIN/ADMIN_IP не секрет
# (адрес и allowlist), но домен временный, а ADMIN_IP — рабочая конфигурация
# стенда, поэтому реальные значения живут на машине, а не в git.

# Публичный домен платформы (без схемы и без завершающей точки).
DOMAIN=example.com

# IP-источник, которому открыты админки CMS и просмотр KYC (files.<DOMAIN>).
# Один адрес или список через пробел, в синтаксисе Caddy `remote_ip`.
# НЕ путать с allowlist центра управления admin.<DOMAIN> — тот задан
# отдельными адресами прямо в Caddyfile (вход через Tailscale/mgmt-vdc1).
ADMIN_IP=203.0.113.0
