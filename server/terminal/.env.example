# Образец. Настоящий .env лежит ТОЛЬКО на сервере, права 600, в git не едет.
# Пароли генерируются на месте и нигде не переиспользуются: пароли контура
# лежали в репозиториях и потому считаются скомпрометированными.
TERMINAL_DB_USER=terminal
TERMINAL_DB_NAME=terminal
TERMINAL_DB_PASSWORD=<сгенерировать: openssl rand -base64 33 | tr -d '/+=' >
