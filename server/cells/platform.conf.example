# Анкета новой платформы. Заполните и запустите:
#     /srv/broker/cells/platform-new.sh <slug>
# Файл лежит в /srv/broker/cells/<slug>/platform.conf. Секретов здесь НЕТ:
# пароли и ключи скрипт создаёт сам и кладёт рядом в .env (права 600).
#
# Пример ниже — выдуманная тестовая платформа «Nordex Markets» для ЕС.

# --- Бренд -----------------------------------------------------------------
# Название, как его увидит клиент.
BRAND_NAME="Nordex Markets"
# Фирменный цвет (hex, 6 знаков).
BRAND_COLOR="#2f6fed"
# Логотип: путь к файлу на сервере (PNG/SVG, ≥512 px по ширине). Пусто — без лого.
BRAND_LOGO=""
# Иконка вкладки (favicon). Пусто — без неё.
BRAND_FAVICON=""

# --- Адреса ----------------------------------------------------------------
# Пять имён. Каждое должно смотреть A-записью на IP сервера (см. НОВАЯ-ПЛАТФОРМА.md).
SITE_HOST="nordex.example.eu"
CABINET_HOST="cabinet.nordex.example.eu"
TERMINAL_HOST="terminal.nordex.example.eu"
ADMIN_HOST="admin.nordex.example.eu"
FILES_HOST="files.nordex.example.eu"

# --- Юрисдикция (то, что работает сегодня без кода) -------------------------
# Маркетинговые акции и бонусы: on — скопировать из шаблона, off — выключить
# (в ЕС/UK стимулы розничным клиентам по CFD запрещены).
PROMOTIONS=off
# Классы инструментов, которые ВЫКЛЮЧИТЬ (через пробел), по полю category
# каталога котировок: crypto fx metals indices stocks. Пусто — как у шаблона.
EXCLUDE_CATEGORIES="stocks"
# Потолок плеча на крипто (1:N, пишем N). Пусто — как в шаблоне (1:10).
CRYPTO_LEVERAGE=2
# Плечо площадки в терминале по умолчанию (1:N).
PLATFORM_LEVERAGE=20
# Стартовый демо-баланс, в центах (1000000 = 10 000 USD).
DEMO_START_BALANCE_CENTS=1000000
# Пороги маржи терминала, % (как у Apex: маржин-колл 100, закрытие 50).
MARGIN_CALL_LEVEL_PERCENT=100
MARGIN_STOP_OUT_LEVEL_PERCENT=50
# Защита от отрицательного баланса: 1 — включена.
NEGATIVE_BALANCE_PROTECTION=1
# Реальная торговля (деньги): 1 — включена, как у Apex.
REAL_TRADING_ENABLED=1

# --- Деньги ----------------------------------------------------------------
# Адрес кошелька USDT (сеть TRON, TRC20). ТОЛЬКО адрес, ключей не нужно и
# давать нельзя. Пусто — приём депозитов в этой платформе выключен.
# !!! Адрес ниже — ВЫДУМАННЫЙ ТЕСТОВЫЙ (валидная контрольная сумма, ключа не
# существует ни у кого). Деньги на него НЕ отправлять. Замените своим.
EXCHANGE_TRON_ADDRESS="TRZbTw7NYaaUw9cEdD4dzbSETWVBem4nGC"

# --- Первый оператор админки -----------------------------------------------
# Логин и имя. Одноразовый пароль скрипт выдаст сам, в конце прогона.
ADMIN_LOGIN="owner"
ADMIN_NAME="Владелец"

# --- Контент ---------------------------------------------------------------
# Из какого сайта CMS копировать разделы (пусто — TEMPLATE_SITE из hub.conf).
TEMPLATE_SITE=""
# Доп. замены текста в копии (кроме названия бренда, оно меняется само).
# Формат: "что=>на что" через «;». Пример: "support@wholesalefy.com=>support@nordex.example.eu"
CONTENT_REPLACE=""
